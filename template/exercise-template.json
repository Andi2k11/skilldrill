{
  "$schemaVersion": "1.0",
  "_instructions": {
    "purpose": "Mall och referens för AI-genererade matematikövningar.",
    "usage": "Kopiera objektet exerciseTemplate när en ny övningsfil skapas. Fält som börjar med _ är dokumentation och ska ignoreras av övningsmotorn.",
    "rules": [
      "Alla övningar ska använda samma grundstruktur.",
      "id ska vara unikt och skrivas med gemener och bindestreck.",
      "question.type anger hur eleven lämnar sitt svar.",
      "generator.type anger hur uppgiften och facit skapas.",
      "Övningsspecifika inställningar ska placeras i generator.parameters.",
      "questionCount ska vara 15 om inget annat anges.",
      "Endast de fält som behövs för vald fråge- och generatortyp ska behållas i den färdiga övningsfilen.",
      "Facit ska genereras av JavaScript och ska inte exponeras för eleven före verifiering."
    ]
  },
  "exerciseTemplate": {
    "id": "",
    "version": "1.0",
    "title": "",
    "book": "Matte Direkt 7",
    "chapter": 1,
    "chapterTitle": "",
    "description": "",
    "settings": {
      "questionCount": 15,
      "showProgress": true,
      "showCorrectAnswer": false,
      "shuffleQuestions": true,
      "allowRetry": true
    },
    "question": {
      "type": "numeric",
      "prompt": "",
      "answer": {
        "format": "integer",
        "acceptedFormats": [
          "integer"
        ],
        "caseSensitive": false,
        "trimWhitespace": true,
        "allowThousandsSeparator": true,
        "decimalSeparator": ",",
        "unit": null,
        "acceptedUnits": [],
        "allowSpaceBeforeUnit": true,
        "selectionMode": null
      }
    },
    "generator": {
      "type": "multiplication",
      "parameters": {}
    }
  },
  "_questionTypes": {
    "numeric": {
      "description": "Ett rent numeriskt svar.",
      "examples": [
        "42",
        "3,5",
        "-7",
        "1000",
        "2^5",
        "1/4"
      ],
      "answerFormats": [
        "integer",
        "decimal",
        "fraction",
        "power",
        "percent",
        "scientificNotation"
      ]
    },
    "numericWithUnit": {
      "description": "Ett tal tillsammans med en enhet.",
      "examples": [
        "10 cm",
        "2,5 kg",
        "45 grader",
        "12 km/h"
      ],
      "answerFormats": [
        "integerWithUnit",
        "decimalWithUnit",
        "fractionWithUnit",
        "percentWithUnit"
      ]
    },
    "text": {
      "description": "Ett kort textsvar.",
      "examples": [
        "triangel",
        "parallell",
        "proportionalitet"
      ],
      "answerFormats": [
        "exactText",
        "acceptedTexts",
        "caseInsensitiveText"
      ]
    },
    "singleChoice": {
      "description": "Ett alternativ ska väljas.",
      "examples": [
        "Vilket tal är ett primtal?",
        "Vilket uttryck har störst värde?"
      ],
      "answerFormats": [
        "singleOption"
      ]
    },
    "multipleChoice": {
      "description": "Ett eller flera alternativ ska väljas.",
      "examples": [
        "Vilka tal är jämna?",
        "Vilka uttryck är ekvivalenta?"
      ],
      "answerFormats": [
        "multipleOptions"
      ]
    },
    "ordering": {
      "description": "Alternativ ska placeras i rätt ordning.",
      "examples": [
        "Sortera talen från minst till störst.",
        "Ordna beräkningsstegen."
      ],
      "answerFormats": [
        "orderedOptions"
      ]
    },
    "matching": {
      "description": "Objekt i två grupper ska paras ihop.",
      "examples": [
        "Para ihop procentform med decimalform.",
        "Para ihop begrepp med förklaring."
      ],
      "answerFormats": [
        "matchedPairs"
      ]
    },
    "expression": {
      "description": "Ett matematiskt uttryck ska skrivas.",
      "examples": [
        "2x + 4",
        "3(a + 2)",
        "x/5"
      ],
      "answerFormats": [
        "exactExpression",
        "equivalentExpression"
      ]
    },
    "coordinate": {
      "description": "En eller flera koordinater anges eller markeras.",
      "examples": [
        "(3, 2)",
        "Markera punkten (-2, 4)."
      ],
      "answerFormats": [
        "coordinatePair",
        "multipleCoordinates",
        "graphClick"
      ]
    },
    "graph": {
      "description": "En punkt, linje, kurva eller graf ska ritas eller identifieras.",
      "examples": [
        "Rita y = 2x + 1.",
        "Markera linjens skärning med y-axeln."
      ],
      "answerFormats": [
        "graphLine",
        "graphPoints",
        "graphFunction"
      ]
    }
  },
